[Unit]
Description=Day 18 plain RSS digest
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/home/user/ai-advent/day18-rss-scheduler
Environment=DAY18_DB_PATH=/home/user/ai-advent/data/feed.sqlite3
Environment=DAY18_DIGEST_MODE=plain
ExecStart=/home/user/ai-advent/day18-rss-scheduler/.venv/bin/python worker.py digest
