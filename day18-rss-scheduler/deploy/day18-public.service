[Unit]
Description=Day 18 read-only public dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/ai-advent/day18-rss-scheduler
Environment=DAY18_DB_PATH=/home/user/ai-advent/data/feed.sqlite3
ExecStart=/home/user/ai-advent/day18-rss-scheduler/.venv/bin/python public_server.py --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/user/ai-advent

[Install]
WantedBy=multi-user.target
