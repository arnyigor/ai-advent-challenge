@echo offchcp 65001 >nulrem ============================================================rem  Day 04 Ч “емпература: проверка окружени€ перед записью видеоrem  “ребовани€: Python 3.10+, Node.js 18+, ffmpeg, Chrome,rem              DEEPSEEK_API_KEY или GEMINI_API_KEYrem ============================================================setlocalcd /d "%~dp0"set FAIL=0set WARN=0echo ============================================echo  Day 4 Temperature Ч environment checkecho ============================================echo.rem --- [1/9] Python ---echo [1/9] python...where python >nul 2>&1if errorlevel 1 (    echo   FAIL: python not found in PATH    set FAIL=1    goto :py_done)for /f "delims=" %%v in ('python --version 2^>^&1') do echo   OK: %%v:py_doneecho.rem --- [2/9] Node.js ---echo [2/9] node...where node >nul 2>&1if errorlevel 1 (    echo   FAIL: node not found in PATH (needed for record-video.mjs)    set FAIL=1    goto :node_done)for /f "delims=" %%v in ('node --version 2^>^&1') do echo   OK: %%v:node_doneecho.rem --- [3/9] ffmpeg ---echo [3/9] ffmpeg...where ffmpeg >nul 2>&1if errorlevel 1 (    echo   FAIL: ffmpeg not found in PATH (set FFMPEG_PATH or add to PATH)    set FAIL=1    goto :ff_done)echo   OK: ffmpeg found:ff_doneecho.rem --- [4/9] Chrome ---echo [4/9] Google Chrome...if defined CHROME_PATH (    if exist "%CHROME_PATH%" (        echo   OK: %CHROME_PATH%    ) else (        echo   WARN: CHROME_PATH set but file not found: %CHROME_PATH%        set WARN=1    )) else (    if exist "C:\Program Files\Google\Chrome\Application\chrome.exe" (        echo   OK: C:\Program Files\Google\Chrome\Application\chrome.exe    ) else (        echo   WARN: Chrome not found at default path. Set CHROME_PATH env var.        set WARN=1    ))echo.rem --- [5/9] API keys ---echo [5/9] API keys...set HAS_KEY=0if defined DEEPSEEK_API_KEY (    echo   OK: DEEPSEEK_API_KEY is set    set HAS_KEY=1)if defined GEMINI_API_KEY (    echo   OK: GEMINI_API_KEY is set    set HAS_KEY=1)if "%HAS_KEY%"=="0" (    echo   FAIL: Neither DEEPSEEK_API_KEY nor GEMINI_API_KEY is set    echo          See tools\API_KEYS.md    set FAIL=1)echo.rem --- [6/9] Python syntax ---echo [6/9] py_compile (all .py in this folder)...set PY_FAIL=0for %%f in (*.py) do (    python -m py_compile "%%f" 2>nul    if errorlevel 1 (        echo   FAIL: syntax error in %%f        set PY_FAIL=1        set FAIL=1    ))if "%PY_FAIL%"=="0" echo   OK: all .py files compile cleanlyecho.rem --- [7/9] Node.js syntax ---echo [7/9] node --check record-video.mjs...if exist "record-video.mjs" (    node --check record-video.mjs 2>nul    if errorlevel 1 (        echo   FAIL: syntax error in record-video.mjs        set FAIL=1    ) else (        echo   OK: record-video.mjs compiles cleanly    )) else (    echo   WARN: record-video.mjs not found    set WARN=1)echo.rem --- [8/9] pytest ---echo [8/9] pytest (Day 4 tests)...python -m pytest ..\tests\test_day4_config.py ..\tests\test_day4_metrics.py -q 2>nulif errorlevel 1 (    echo   FAIL: some tests failed    set FAIL=1) else (    echo   OK: all Day 4 tests passed)echo.rem --- [9/9] secrets scan ---echo [9/9] check-secrets.ps1...powershell -NoProfile -ExecutionPolicy Bypass -File "..\tools\check-secrets.ps1" -Path "."if errorlevel 1 (    echo   FAIL: possible secrets found    set FAIL=1) else (    echo   OK: no secrets detected)echo.rem --- Summary ---echo ============================================if "%FAIL%"=="1" (    echo  RESULT: FAIL Ч fix the items above before recording    echo.    echo  Next steps after fixes:    echo    1. Start web server:  python web_server.py --port 8766    echo    2. Open http://127.0.0.1:8766 in browser    echo    3. Record video:      node record-video.mjs --out ..\ChallengeVideos\day04-demo.mp4    goto :result_done)if "%WARN%"=="1" (    echo  RESULT: OK with warnings Ч review above, but can proceed) else (    echo  RESULT: OK Ч environment is ready)echo.echo  Next steps:echo    1. Start web server in a separate window:echo         python web_server.py --port 8766echo.echo    2. Open http://127.0.0.1:8766 in browser, click "«апуск"echo       (or load Replay from pilot-deepseek.json to save API quota)echo.echo    3. Record video (in another terminal):echo         node record-video.mjs --out ..\ChallengeVideos\day04-demo.mp4echo.echo    4. Final submission:echo         powershell -ExecutionPolicy Bypass -File ..\tools\submit-day.ps1 -Day 4 -Video "..\ChallengeVideos\day04-demo.mp4":result_doneecho ============================================endlocalpause